/// @description Sprite Definition
if(player.weapon == weapon_type.staff){
	idle_sprite = spr_wiz_idle
	idle_up_sprite = spr_wiz_idle_up
	idle_down_sprite = spr_wiz_idle_down
	idle_down_angled_sprite = spr_wiz_idle_down_angled
	idle_up_angled_sprite = spr_wiz_idle_up_angled
}else{
	idle_sprite = spr_wiz_idle_left_unarmed
	idle_up_sprite = spr_wiz_idle_up_unarmed
	idle_down_sprite = spr_wiz_idle_down_unarmed
	idle_down_angled_sprite = ""
	idle_up_angled_sprite = ""
	melee_down_sprite = spr_wiz_melee_down
	melee_up_sprite = spr_wiz_melee_up
	melee_left_sprite = spr_wiz_melee_left
	melee_dash_left_sprite = spr_wiz_melee_dash_left
	melee_dash_down_sprite = spr_wiz_melee_dash_down
	melee_dash_up_sprite = spr_wiz_melee_dash_up
}

